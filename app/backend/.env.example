# ShopeeFood AI Backend Environment
#
# Copy this file to `.env` in the same folder when you want to enable
# the live Gemini-powered chat flow:
#
#   cp .env.example .env
#
# Leave the value empty or omit `.env` to use the built-in fallback recommender.

GEMINI_API_KEY=

# Optional: override the Gemini model used by app/backend/services/gemini_service.py
# GEMINI_MODEL=gemini-2.5-flash
